#vcomment
  font-size: 1.1em

  .vbtn
    border: none
    background: var(--btn-bg)
    color: var(--btn-color)

    &:hover
      background: var(--btn-hover-color)

  .vimg
    transition: all .3s

    &:hover
      transform: rotate(360deg)

  .vcards .vcard .vcontent.expand
    &:before,
    &:after
      z-index: 22

#waline-wrap
  --waline-font-size: 1.1em
  --waline-theme-color: $button-bg
  --waline-active-color: $button-hover-color

  .wl-comment-actions > button:not(last-child)
    padding-right: 4px

if hexo-config('valine.bg')
  #vcomment
    textarea
      background: url(hexo-config('valine.bg')) 100% 100% no-repeat

      &:focus
        background-image: none

if hexo-config('waline.bg')
  #waline-wrap
    textarea
      background: url(hexo-config('waline.bg')) 100% 100% no-repeat

      &:focus
        background-image: none

.twikoo
  .tk-content
    p
      margin: 3px 0

.fireworks
  position: fixed
  top: 0
  left: 0
  z-index: $fireworks-zIndex
  pointer-events: none

.medium-zoom-image--opened
  z-index: 99999 !important
  margin: 0 !important

.medium-zoom-overlay
  z-index: 99999 !important

// 基于 hexo-config 的判断保持不变
if hexo-config('mermaid.enable')
  .mermaid-wrap
    position: relative
    margin: 0 0 20px
    border: 1px solid var(--light-grey, #e2e2e2)
    border-radius: 8px
    background: var(--card-bg, #f7f7f7)
    overflow: hidden

    // 头部 Tab 栏
    .mermaid-header
      display: flex
      justify-content: space-between
      align-items: center
      padding: 8px 15px
      background: var(--hltools-bg, #f0f0f0)
      border-bottom: 1px solid var(--light-grey, #e2e2e2)

    .mermaid-tabs
      display: flex
      gap: 10px

    .mermaid-tab-btn
      background: none
      border: none
      padding: 5px 12px
      cursor: pointer
      font-size: 13px
      border-radius: 4px
      color: var(--hltools-color, #555)
      transition: all 0.3s

      &.active
        background: var(--btn-hover-color, #d3d3d3) // 适配原主题的灰色激活态
        color: var(--white, #fff)

    // 预览区域
    .mermaid-preview-container
      position: relative
      padding: 10px
      background: var(--global-bg, #fff)
      display: flex
      justify-content: center
      overflow: hidden

      & > svg
        max-width: 100%
        height: auto // 改为 auto 保证比例不失真
        if hexo-config('mermaid.zoom_pan')
          cursor: grab
          user-select: none
          touch-action: none
          &:active
            cursor: grabbing

    // 源码区域：强制左对齐
    .mermaid-source-container
      display: none
      padding: 15px
      background: var(--global-bg, #282c34)
      color: #abb2bf
      font-family: $code-font, monospace
      overflow-x: auto
      text-align: left !important

      pre
        margin: 0
        padding: 0 !important
        background: transparent !important
        text-align: left !important

      code
        display: block
        text-align: left !important
        white-space: pre

    // 放大镜按钮
    .mermaid-open-btn
      cursor: pointer
      border: none
      background: none
      color: var(--font-color, #555)
      font-size: 16px
      transition: color .2s ease

      &:hover
        color: $light-blue || #49b1f5

  // 如果配置了 code_write，隐藏原始 code 块
  if hexo-config('mermaid.code_write')
    pre > code.mermaid
      display: none

if hexo-config('chartjs.enable')
  .chartjs-container
    display: flex
    flex-direction: column
    justify-content: center
    align-items: center
    margin: 0 0 20px
    text-align: center
    gap: 20px

    +maxWidth600()
      .chartjs-wrap
        width: 100% !important

    &.chartjs-abreast
      flex-direction: row

      +maxWidth600()
        flex-direction: column

    .chartjs-wrap
      width: -webkit-fill-available

    canvas
      display: inline-block !important

.utterances,
.fb-comments iframe
  width: 100% !important

#gitalk-container
  .gt-meta
    margin: 0 0 .8em
    padding: 6px 0 16px

if hexo-config('math.use')
  .katex-display
    overflow: auto hidden
    padding: 5px

    .katex-show
      display: block

  .katex
    display: none

    &.katex-show
      display: inline

  if hexo-config('math.hide_scrollbar')
    .katex-display,
    mjx-container
      scrollbar-width: none

      &::-webkit-scrollbar
        display: none

  // Mathjax
  mjx-container
    overflow-x: auto
    overflow-y: hidden
    padding-bottom: 4px
    max-width: 100%

    &[display]
      display: block !important
      min-width: auto !important

    &:not([display])
      display: inline-grid !important

  mjx-assistive-mml
    right: 0
    bottom: 0

.aplayer
  color: $font-black

.container
  .aplayer
    margin: 0 0 20px

    if hexo-config('beautify.enable')
      ol,
      ul
        margin: 0
        padding: 0

        li
          margin: 0
          padding: 0 15px

          &:before
            content: none

.snackbar-container.snackbar-css
  addBorderRadius(5)
  opacity: .85 !important

.abc-music-sheet
  margin: 0 0 20px
  opacity: 0
  transition: opacity .3s

  &.abcjs-container
    opacity: 1

+maxWidth768()
  .fancybox__toolbar__column.is-middle
    display: none
