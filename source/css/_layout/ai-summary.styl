// ===================
// 🌗 主题变量定义（仅使用项）
// ===================

:root
  // ai_summary
  --ai-summary-title-font-color: #0883b7
  --ai-summary-maskbg: rgba(255, 255, 255, 0.85)
  --ai-summary-ai-bg: conic-gradient(from 1.5708rad at 50% 50%, #00d6ad45 0%, #42a2ffb8 54%, #a0ab0066 100%)

  // card 背景
  --ai-summary-card-secondbg: #f1f3f8

  // text
  --ai-summary-text: #424242
  --ai-summary-secondtext: #3c3c43cc

[data-theme='dark']
  // ai_summary
  --ai-summary-title-font-color: #0883b7
  --ai-summary-maskbg: rgba(0, 0, 0, 0.85)
  --ai-summary-ai-bg: conic-gradient(from 1.5708rad at 50% 50%, #1eff0033 0%, #28e3d37d 54%, #c307a866 100%)

  // card 背景
  --ai-summary-card-secondbg: #3e3f41

  // text
  --ai-summary-text: rgb(154 154 154)
  --ai-summary-secondtext: #a1a2b8

// ===================
// 📘 AI 摘要模块样式
// ===================

if hexo-config('ai_summary.enable')
  .ai-summary
    background-color var(--ai-summary-maskbg)
    background var(--ai-summary-card-secondbg)
    border-radius 12px
    padding 8px 8px 12px 8px
    line-height 1.3
    flex-direction column
    margin-bottom 16px
    display flex
    gap 5px
    position relative

    &::before
      content ''
      position absolute
      top 0
      left 0
      width 100%
      height 100%
      z-index 1
      filter blur(8px)
      opacity .4
      background-image var(--ai-summary-ai-bg)
      transform scaleX(1) scaleY(.95) translateY(2px)

    &::after
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      border-radius: 12px;
      background: var(--ai-summary-maskbg);

    .ai-explanation
      z-index 10
      padding 8px 12px
      font-size 13px
      line-height 1.4
      color var(--ai-summary-text)
      text-align justify

      // ✅ 打字机光标动画
      &::after
        content ''
        display inline-block
        width 8px
        height 2px
        margin-left 2px
        background var(--ai-summary-text)
        vertical-align bottom
        animation blink-underline 1s ease-in-out infinite
        transition all .3s
        position relative
        bottom 3px

      // 平滑滚动动画
      // .char
      //   display inline-block
      //   opacity 0
      //   animation chat-float .5s ease forwards

    .ai-title
      z-index 10
      font-size 14px
      display flex
      border-radius 8px
      align-items center
      position relative
      padding 0 12px
      cursor default
      user-select none

      .ai-title-left
        display flex
        align-items center
        color var(--ai-summary-title-font-color)

        i
          margin-right 3px
          display flex
          color var(--ai-summary-title-font-color)
          border-radius 20px
          justify-content center
          align-items center

        .ai-title-text
          font-weight 500

      .ai-tag
        color var(--ai-summary-secondtext)
        font-weight 300
        margin-left auto
        display flex
        align-items center
        justify-content center
        transition .3s

  // 平滑滚动动画
  // @keyframes chat-float
  //   0%
  //     opacity 0
  //     transform translateY(20px)
  //   100%
  //       opacity 1
  //       transform translateY(0)

  // ✅ 打字机光标闪烁动画
  @keyframes blink-underline
    0%, 100%
      opacity 1
    50%
      opacity 0
