if theme.preloader.enable
  if theme.preloader.source === 9997
    include ./wave-loading.pug
  else if theme.preloader.source === 9998
    include ./check-list-loading.pug
  else if theme.preloader.source === 9999
    include ./fullpage-loading.pug
  else
    include ./pace.pug

script.
  (()=>{
    const $loadingBox = document.getElementById('loading-box')
    const $loadingHint = document.getElementById('loading-hint')
    const $body = document.body
    let hintTimer = null
    let forceTimer = null
    const preloader = {
      endLoading: () => {
        if (!$loadingBox || $loadingBox.classList.contains('loaded')) return

        if ($loadingHint && $loadingHint.style.display !== 'none') {
          $loadingHint.classList.add('exit-active')
        }

        // 清理所有计时器
        if (hintTimer) clearTimeout(hintTimer)
        if (forceTimer) clearTimeout(forceTimer)

        $body.style.overflow = ''
        $loadingBox.classList.add('loaded')
      },
      initLoading: () => {
        $loadingBox.classList.remove('loaded')
        if (!$loadingHint) return

        $body.style.overflow = 'hidden'
        $loadingBox.classList.remove('loaded')
        $loadingBox.classList.remove('allow-skip') // 重置状态
        if ($loadingHint) {
          $loadingHint.style.display = 'none'
          $loadingHint.classList.remove('exit-active') // 重置类名
        }

        // 手动跳过按钮
        hintTimer = setTimeout(() => {
          const currentHint = document.getElementById('loading-hint')
          const currentBox = document.getElementById('loading-box')
          if (currentBox && !currentBox.classList.contains('loaded')) {
            if (currentHint) currentHint.style.display = 'flex'
            currentBox.classList.add('allow-skip') // 允许点击样式

            // 绑定全屏点击事件
            currentBox.onclick = () => {
              preloader.endLoading()
              currentBox.onclick = null // 点击后解绑
            }
          }
        }, 7000)

        forceTimer = setTimeout(() => {
          if (!$loadingBox.classList.contains('loaded')) {
            console.warn('Preloader: 加载超时，强制关闭')
            preloader.endLoading()
          }
        }, 6000)
      }
    }

    preloader.initLoading()

    // 注释掉自动移除逻辑
    // 我们不希望它在 window.onload 时自动消失，我们要手动控制
    /*
    if (document.readyState === 'complete') {
      preloader.endLoading()
    } else {
      window.addEventListener('load', preloader.endLoading)
      document.addEventListener('DOMContentLoaded', preloader.endLoading)
      // Add timeout protection: force end after 7 seconds
      setTimeout(preloader.endLoading, 7000)
    }
    */

    // 暴露到全局，让外部 JS (Keycloak) 可以调用
    window.endPreloader = preloader.endLoading

    if (!{theme.pjax && theme.pjax.enable}) {
      btf.addGlobalFn('pjaxSend', preloader.initLoading, 'preloader_init')
      btf.addGlobalFn('pjaxComplete', preloader.endLoading, 'preloader_end')
    }
  })()